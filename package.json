{
  "name": "watchtower-siba-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Watchtower (SIBA) - Automated Follow-up Monitor for IDX (Deterministic Core Engine)",
  "main": "dist/index.js",
  "scripts": {
    "start": "bash start.sh",
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"cd bot && . venv/bin/activate && python main.py\"",
    "demo:cli": "tsx src/demo.ts",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "idx",
    "stocks",
    "automation",
    "workflow",
    "deterministic",
    "sectors"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/router-devtools": "^1.167.2",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^22.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
