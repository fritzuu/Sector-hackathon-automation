# =====================================================================
# SIBA TELEGRAM BOT CONFIGURATION (Sector-hackathon-automation)
# =====================================================================

# Bot Token from Telegram @BotFather (e.g. 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Optional default broadcast chat ID or group ID
# (When sending alerts without specific recipient, this ID will receive them)
DEFAULT_CHAT_ID=""

# Alert Ingestion Webhook Server (receives events from Sector-hackathon-automation)
WEBHOOK_HOST="127.0.0.1"
WEBHOOK_PORT=8088

# Optional API key protection for webhook POST /api/alert
# Leave empty for local development without token requirement
WEBHOOK_SECRET_KEY=""

# Guardrail: Replay isolation (PRD P0-09)
# Must remain False in production to prevent simulated historical runs from spamming Telegram
ENABLE_REPLAY_ALERTS=false

# Local storage path for subscribers and pairing tokens
STORAGE_FILE="./data/storage.json"

# Dashboard base URL for "Lihat detail kasus" buttons
DASHBOARD_URL="http://localhost:5173"

# Supabase (sama dengan frontend). Bot memakai RPC pairing, bukan user dummy.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_KEY=YOUR_PUBLISHABLE_OR_SERVICE_ROLE_KEY

