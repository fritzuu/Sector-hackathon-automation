# ─────────────────────────────────────────────────────────────────
# SIBA — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────

# ── Sectors API ───────────────────────────────────────────────────
# Dapatkan dari https://sectors.app/api — digunakan untuk data harga
# harian IDX dan benchmark IHSG.
# Limit: sesuai paket akun Anda; pantau sisa kredit sebelum deploy.
VITE_SECTORS_API_KEY=YOUR_SECTORS_API_KEY_HERE

# ── Telegram Bot ──────────────────────────────────────────────────
# Token bot Telegram (format: 123456789:ABCdefGHI...).
# Dapatkan dari @BotFather di Telegram.
# Token ini di-proxy oleh Vite (/tg-api) sehingga tidak pernah
# muncul di network tab browser.
VITE_TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Username bot Telegram tanpa tanda @
# (contoh: siba_idx_bot). Ditampilkan di modal pairing agar
# pengguna tahu bot mana yang harus dicari.
VITE_TELEGRAM_BOT_USERNAME=siba_idx_bot
